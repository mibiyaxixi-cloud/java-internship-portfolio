# 复制为 .env 并填写本机值；密钥、账号密码仅用环境变量，禁止提交 .env。
DB_URL=jdbc:mysql://127.0.0.1:13308/knowledge?connectionTimeZone=UTC
DB_USERNAME=knowledge
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
ADMIN_PASSWORD=
READER_PASSWORD=
READER2_PASSWORD=
SERVER_PORT=8082
SERVER_ADDRESS=127.0.0.1
COOKIE_SECURE=false
# 默认为显式 mock；不使用凭证，不代表真实效果。real 缺配置会启动失败，不回退。
AI_MODE=mock
# OpenAI 兼容协议根 URL（不要以 /v1 结尾）；分别需要 /v1/chat/completions 和 /v1/embeddings。
CHAT_BASE_URL=
CHAT_API_KEY=
CHAT_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
# 必须等于提供方实际输出维度；本项目不发送 dimensions 缩维参数。
EMBEDDING_DIMENSIONS=1536
AI_TIMEOUT_SECONDS=30
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
CHUNK_SIZE=600
CHUNK_OVERLAP=80
TOP_K=4
MIN_SCORE=0.20
# 仅 verify 使用，必须是独立 knowledge_test 库；不要填开发库。
TEST_DB_URL=jdbc:mysql://127.0.0.1:13308/knowledge_test?connectionTimeZone=UTC
TEST_DB_USERNAME=knowledge_test
TEST_DB_PASSWORD=
# M2：单实例、每60秒窗口；代理共享IP时登录限流也共享，不信任客户端X-Forwarded-For。
LOGIN_PER_MINUTE=10
QUESTIONS_PER_MINUTE=20
IMPORTS_PER_MINUTE=30
MAX_CONCURRENT_QUESTIONS=4
MAX_CONCURRENT_IMPORTS=2
QDRANT_TIMEOUT_SECONDS=10
AI_DEADLINE_SECONDS=35

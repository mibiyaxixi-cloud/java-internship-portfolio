# 复制为 .env，并填写本机数据库账号；不要提交 .env。
# macOS/Linux 的 scripts/backend.sh 会读取此文件；Spring Boot 本身不自动读取 .env。
DB_URL='jdbc:mysql://127.0.0.1:13306/bookflow?connectionTimeZone=Asia/Shanghai'
DB_USERNAME=bookflow
DB_PASSWORD=replace_with_your_local_password
TEST_DB_URL='jdbc:mysql://127.0.0.1:13306/bookflow_test?connectionTimeZone=Asia/Shanghai'
TEST_DB_USERNAME=bookflow_test
TEST_DB_PASSWORD=replace_with_your_test_password
SPRING_PROFILES_ACTIVE=demo
# 仅本机访问，公网部署另行设计。
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# macOS JDK 未注册时填写实际 JDK Home；不要填写 bin/java。
# JAVA_HOME=/absolute/path/to/jdk-21/Contents/Home
# 如 mysql/mysqld 不在 PATH，设置包含这些命令的目录。
# MYSQL_BIN=/absolute/path/to/mysql/bin

# demo profile 首次创建账号时必填，12～72 UTF-8 字节。
# 复制模板后执行 node scripts/prepare-demo.mjs，自动追加以下三项随机密码。
# DEMO_USER_PASSWORD=
# DEMO_SECOND_USER_PASSWORD=
# DEMO_ADMIN_PASSWORD=

# 候补限时确认与扫描。期限以发出资格时写入数据库的值为准。
WAITLIST_OFFER_SECONDS=900
WAITLIST_SCAN_DELAY_MS=5000
WAITLIST_SCHEDULING_ENABLED=true
